# Copy to .env on the server. Never commit .env.
APP_ENV=production
POSTGRES_USER=payment
POSTGRES_PASSWORD=change-me
POSTGRES_DB=payment_engine
DATABASE_URL=postgres://payment:change-me@postgres:5432/payment_engine
FAKE_PSP_SECRET=change-me
# Keep the fake-PSP simulator (/dev/fake-psp/events) on while fake is the only PSP.
ENABLE_FAKE_PSP_EVENTS=true
