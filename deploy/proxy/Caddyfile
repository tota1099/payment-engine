# One block per project. Caddy issues and renews TLS certificates itself.
# Reload after editing: docker compose exec caddy caddy reload --config /etc/caddy/Caddyfile

api.payment-engine.mydomain.com {
	# The API trusts X-Consumer-Username (normally set by an API gateway), so
	# Caddy plays gateway: a valid bearer key sets the header, anything else
	# gets 401. A client-sent X-Consumer-Username is always overwritten.
	# ponytail: one static key per consumer; move to a real gateway when there are many.
	handle /api/v1/webhooks {
		# PSP webhooks authenticate by signature, not by key.
		reverse_proxy payment-engine-api:8080 {
			header_up -X-Consumer-Username
		}
	}

	@authed header Authorization "Bearer {$PE_API_KEY}"
	handle @authed {
		reverse_proxy payment-engine-api:8080 {
			header_up X-Consumer-Username {$PE_CONSUMER}
		}
	}

	respond 401
}
