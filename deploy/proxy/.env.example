# Copy to .env next to compose.yml.
# Key: openssl rand -hex 32
PE_API_KEY=change-me
PE_CONSUMER=my-consumer
# Swagger UI login at /docs/. Hash: docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
# Keep the single quotes: the bcrypt hash contains "$".
DOCS_USER=admin
DOCS_PASSWORD_HASH='$2a$14$replace-with-hash'
